        </mxCell>
        <mxCell id="e-transition" value="state transition" style="endArrow=classic;html=1;strokeColor=#143d2b;fontColor=#5d665d;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="op" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-bind" style="endArrow=classic;html=1;strokeColor=#5d665d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bind-group" target="op">
          <mxGeometry relative="1" as="geometry" />
