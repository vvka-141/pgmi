<mxfile host="app.diagrams.net">
  <diagram id="a06-request-becomes-transaction" name="request-becomes-transaction">
    <mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#fbfaf7" adaptiveColors="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="edge-box" value="&lt;b&gt;network edge &#8212; gateway&lt;/b&gt;&lt;br/&gt;TLS &#183; credential verification &#183; rate limiting &#183; pooling&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#5d665d&#39;&gt;adapts the protocol; holds no business rule&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#172018;fontSize=11;spacingLeft=40;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="amber-label" value="the request becomes a transaction&#10;BEGIN with the operation&#8217;s declared policy" style="text;html=1;align=left;verticalAlign=middle;fontColor=#b45309;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="396" y="98" width="312" height="36" as="geometry" />
        </mxCell>
        <mxCell id="txn" value="inside PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d9ded5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=6;fontColor=#5d665d;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="700" height="350" as="geometry" />
        </mxCell>
        <mxCell id="proof" value="&lt;b&gt;executable proof&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;tests invoke the operation end to end inside the deploy transaction, assert on response and state in one snapshot, then ROLLBACK&lt;br/&gt;&lt;br/&gt;a failing declared outcome refuses the commit" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#143d2b;fontColor=#172018;fontSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="200" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="op" value="&lt;b&gt;transactional operation&lt;/b&gt;&lt;br/&gt;the unit of design&lt;br/&gt;&lt;br/&gt;typed contract &#183; authorization policy&lt;br/&gt;transaction policy &#183; tests&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39;&gt;handler: materialize &#8594; validate &#8594; probe &#8594; transition&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#143d2b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="245" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bind-group" value="bindings &#8212; projections&#10;of one catalog" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d9ded5;verticalAlign=top;align=center;spacingTop=6;fontColor=#5d665d;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="545" y="200" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b-rest" value="REST route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="557" y="244" width="146" height="32" as="geometry" />
        </mxCell>
        <mxCell id="b-oas" value="OpenAPI operation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="557" y="288" width="146" height="32" as="geometry" />
        </mxCell>
        <mxCell id="b-mcp" value="MCP tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="557" y="332" width="146" height="32" as="geometry" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;PostgreSQL state&lt;/b&gt; &#8212; constraints &#183; row-level security &#183; indexes&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#5d665d&#39;&gt;the operation catalog itself is rows in this state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="45" y="410" width="670" height="56" as="geometry" />
        </mxCell>
        <mxCell id="triad" value="one authority &#183; one transaction &#183; one executable proof" style="text;html=1;align=center;verticalAlign=middle;fontColor=#143d2b;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="470" width="670" height="22" as="geometry" />
        </mxCell>
        <mxCell id="e-amber" style="endArrow=classic;html=1;strokeColor=#b45309;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="edge-box" target="op">
