        <mxCell id="e-proof" style="endArrow=classic;html=1;strokeColor=#143d2b;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="proof" target="op">
