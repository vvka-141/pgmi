<mxGraphModel adaptiveColors="none" background="#fbfaf7" grid="0" page="1" pageWidth="980" pageHeight="640">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="lbl" value="DEPLOY SEQUENCE — ONE CONNECTION, NUMBERED EXITS" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#143d2b;" vertex="1" parent="1"><mxGeometry x="140" y="20" width="440" height="20" as="geometry" /></mxCell>
    <mxCell id="b1" value="you: pgmi deploy . -d mydb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="52" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b2" value="validate the project — deploy.sql must exist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="116" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b3" value="connect · create the database if missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="180" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b4" value="acquire the per-database deploy lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="244" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b5" value="prepare the session — temp tables and views:&#10;files · checksums · parameters loaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="308" width="440" height="50" as="geometry" /></mxCell>
    <mxCell id="b6" value="preprocess — expand CALL pgmi_test() macros" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="384" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b7" value="your deploy.sql runs — atomic head through the first&#10;top-level COMMIT, then per-statement tail (psql mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#b45309;fontColor=#ffffff;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="448" width="440" height="50" as="geometry" /></mxCell>
    <mxCell id="b8" value="session closes — deploy lock released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="140" y="524" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="f1" style="html=1;endArrow=classic;strokeColor=#5d665d;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f2" style="html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f3" style="html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f4" style="html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f5" style="html=1;endArrow=classic;strokeColor=#0f766e;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f6" value="hands control" style="html=1;endArrow=classic;strokeColor=#b45309;strokeWidth=2;fontColor=#b45309;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f7" style="html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="x2" value="exit 14 — deploy.sql not found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="660" y="121" width="250" height="28" as="geometry" /></mxCell>
    <mxCell id="x3" value="exit 10 config · exit 11 connection failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="660" y="185" width="250" height="28" as="geometry" /></mxCell>
    <mxCell id="x4" value="exit 15 — concurrent deploy detected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="660" y="249" width="250" height="28" as="geometry" /></mxCell>
    <mxCell id="x7" value="exit 13 SQL failed · exit 16 timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="660" y="459" width="250" height="28" as="geometry" /></mxCell>
    <mxCell id="x8" value="exit 0 — success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#143d2b;fontStyle=1;fontSize=11" vertex="1" parent="1"><mxGeometry x="660" y="529" width="250" height="28" as="geometry" /></mxCell>
    <mxCell id="g2" style="html=1;endArrow=classic;dashed=1;strokeColor=#5d665d;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b2" target="x2"><mxGeometry relative="1" as="geometry" /></mxCell>
