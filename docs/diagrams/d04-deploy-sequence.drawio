<mxGraphModel adaptiveColors="none" background="#fbfaf7" grid="0" page="1" pageWidth="1060" pageHeight="680">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="lbl" value="DEPLOY SEQUENCE — ONE SESSION PER ATTEMPT, NUMBERED EXITS" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#143d2b;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="520" height="20" as="geometry" /></mxCell>
    <mxCell id="grp" value="ONE ATTEMPT" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#143d2b;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=10;fontColor=#143d2b;spacingLeft=10;spacingTop=2" vertex="1" parent="1"><mxGeometry x="200" y="176" width="480" height="364" as="geometry" /></mxCell>
    <mxCell id="b1" value="you: pgmi deploy . -d mydb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="52" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b2" value="check the configuration · load the project — deploy.sql must exist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="116" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b3" value="sign in (cloud) · connect · create the database if missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="206" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b4" value="acquire the per-database deploy lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="270" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b5" value="prepare the session — temp tables and views:&#10;files · checksums · parameters loaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="334" width="440" height="50" as="geometry" /></mxCell>
    <mxCell id="b6" value="preprocess — expand CALL pgmi_test() macros" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="410" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="b7" value="your deploy.sql runs — atomic head through the first&#10;top-level COMMIT, then per-statement tail (psql mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#b45309;fontColor=#ffffff;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="474" width="440" height="50" as="geometry" /></mxCell>
    <mxCell id="b8" value="session closes — deploy lock released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="220" y="566" width="440" height="38" as="geometry" /></mxCell>
    <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5d665d;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0f766e;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f6" value="hands control" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#b45309;strokeWidth=2;fontColor=#b45309;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"><mxPoint x="62" y="0" as="offset" /></mxGeometry></mxCell>
    <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#143d2b;exitX=0;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b7" target="b3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="499" /><mxPoint x="170" y="225" /></Array></mxGeometry></mxCell>
    <mxCell id="loopLbl" value="transient failure:&lt;br&gt;close the session,&lt;br&gt;wait (backoff),&lt;br&gt;start again while&lt;br&gt;the --timeout box lasts" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontColor=#143d2b;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="20" y="312" width="140" height="100" as="geometry" /></mxCell>
    <mxCell id="x2" value="exit 10 config · exit 14 deploy.sql not found" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="740" y="121" width="280" height="28" as="geometry" /></mxCell>
    <mxCell id="x3" value="exit 11 — connection failed&lt;br&gt;or --timeout reached while connecting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="740" y="205" width="280" height="40" as="geometry" /></mxCell>
    <mxCell id="x4" value="exit 15 — concurrent deploy detected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="740" y="275" width="280" height="28" as="geometry" /></mxCell>
    <mxCell id="x7" value="exit 13 — SQL failed&lt;br&gt;exit 16 — --timeout reached while SQL runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=11" vertex="1" parent="1"><mxGeometry x="740" y="479" width="280" height="40" as="geometry" /></mxCell>
    <mxCell id="x8" value="exit 0 — success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#143d2b;fontStyle=1;fontSize=11" vertex="1" parent="1"><mxGeometry x="740" y="571" width="280" height="28" as="geometry" /></mxCell>
    <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#5d665d;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b2" target="x2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#5d665d;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b3" target="x3"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#5d665d;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b4" target="x4"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#5d665d;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b7" target="x7"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#143d2b;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b8" target="x8"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="cap" value="the failure surface is numbered — a CI pipeline can branch on the exit code without parsing output" style="text;html=1;align=center;fontStyle=2;fontSize=12;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="800" height="20" as="geometry" /></mxCell>
