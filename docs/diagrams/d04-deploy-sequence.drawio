    <mxCell id="cap" value="the failure surface is numbered — a CI pipeline can branch on the exit code without parsing output" style="text;html=1;align=center;fontStyle=2;fontSize=12;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="140" y="592" width="640" height="20" as="geometry" /></mxCell>
