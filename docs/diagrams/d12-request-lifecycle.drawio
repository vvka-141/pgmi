    <mxCell id="gw" value="your gateway&#10;resolve-then-open&#10;&#10;api.rest_route_policy(…)&#10;BEGIN at max(floor, requested)&#10;[READ ONLY [DEFERRABLE]]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="190" y="126" width="220" height="118" as="geometry" /></mxCell>
