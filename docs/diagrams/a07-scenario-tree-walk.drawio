        </mxCell>
        <mxCell id="fail" value="&#10007;  any violated invariant aborts the whole transaction &#8212; neither schema nor test rows commit" style="text;html=1;align=left;verticalAlign=middle;fontColor=#5d665d;fontSize=12;" vertex="1" parent="1">
