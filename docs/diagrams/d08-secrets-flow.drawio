  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="lbl" value="SECRETS AS PARAMETERS — THE SUPPORTED PATH AND THE BANNED ONE" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#143d2b;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="520" height="20" as="geometry" /></mxCell>
    <mxCell id="pf" value="secrets file — CI-generated,&#10;never committed&#10;(database_admin_password=…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="60" y="60" width="240" height="76" as="geometry" /></mxCell>
    <mxCell id="cli" value="pgmi deploy . --params-file secrets.env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="370" y="74" width="280" height="48" as="geometry" /></mxCell>
    <mxCell id="sx" value="one PostgreSQL session — gone when it ends" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="60" y="176" width="860" height="140" as="geometry" /></mxCell>
    <mxCell id="tt" value="_pgmi_parameter — session temp table&#10;+ pgmi.* session GUCs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="90" y="216" width="330" height="66" as="geometry" /></mxCell>
    <mxCell id="cs" value="your SQL reads them:&#10;current_setting('pgmi.database_admin_password')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#b45309;fontColor=#ffffff;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="500" y="216" width="390" height="66" as="geometry" /></mxCell>
    <mxCell id="ef" style="html=1;endArrow=classic;strokeColor=#5d665d;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="pf" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="es" style="html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="cli" target="sx"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="et" style="html=1;endArrow=classic;strokeColor=#0f766e;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="tt" target="cs"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="nx" value="NEVER ON THESE PATHS (PGMI CORE)" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="60" y="344" width="300" height="20" as="geometry" /></mxCell>
    <mxCell id="x1" value="✗ the command line — --param key=secret&#10;leaks to ps, shell history, and CI logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=12" vertex="1" parent="1"><mxGeometry x="60" y="372" width="280" height="56" as="geometry" /></mxCell>
    <mxCell id="x2" value="✗ pgmi's own logs —&#10;core logs counts, never values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=12" vertex="1" parent="1"><mxGeometry x="360" y="372" width="280" height="56" as="geometry" /></mxCell>
    <mxCell id="x3" value="✗ disk — pgmi persists nothing&#10;outside the session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#5d665d;fontSize=12" vertex="1" parent="1"><mxGeometry x="660" y="372" width="260" height="56" as="geometry" /></mxCell>
    <mxCell id="cv" value="stay honest about the edges: pgmi.* GUCs are visible to the deploy session via SHOW ALL / pg_settings · ALTER ROLE … PASSWORD is DDL, so the cleartext can reach the SERVER log under log_statement = ddl/all · anything the advanced template's deploy.sql logs is YOUR code — it masks secret-like keys; keep that pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9ded5;fontColor=#5d665d;fontStyle=2;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="456" width="860" height="70" as="geometry" /></mxCell>
    <mxCell id="cap" value="secrets as parameters are supported and expected — the banned path is the command line" style="text;html=1;align=center;fontStyle=2;fontSize=12;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="90" y="548" width="800" height="20" as="geometry" /></mxCell>
  </root>
