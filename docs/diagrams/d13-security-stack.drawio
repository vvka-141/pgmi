    <mxCell id="lbl" value="MULTI-TENANT SECURITY STACK (ADVANCED TEMPLATE)" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#143d2b;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="420" height="20" as="geometry" /></mxCell>
    <mxCell id="idp" value="browser · OIDC identity provider&#10;transport signs in, calls api.open_login_session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="110" y="60" width="330" height="52" as="geometry" /></mxCell>
    <mxCell id="mk" value="MCP client&#10;connection a person approved on the web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#5d665d;dashed=1;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="540" y="60" width="330" height="52" as="geometry" /></mxCell>
    <mxCell id="px" value="transport — login handle in an httpOnly cookie,&#10;drops client-sent session headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="110" y="152" width="330" height="56" as="geometry" /></mxCell>
    <mxCell id="vk" value="MCP gateway — forwards X-Connection&#10;and nothing else into the context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="540" y="152" width="330" height="56" as="geometry" /></mxCell>
    <mxCell id="guc" value="trust gate + request context — only a login in the api role states a context&#10;handles resolved once per request (sha256 lookup) · one organization per request · header case collisions answer 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="110" y="256" width="760" height="56" as="geometry" /></mxCell>
    <mxCell id="clm" value="membership + declared access — live session of an enabled person · current membership in an active organization&#10;role permissions · platform permissions need MFA · gateway answers 401/403 before the handler body runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="110" y="360" width="760" height="56" as="geometry" /></mxCell>
    <mxCell id="rls" value="forced row-level security&#10;policies scope the owner to the request's organization · kernels check their reach · security_invoker views keep RLS in force" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f4e8;strokeColor=#0f766e;strokeWidth=2;fontColor=#172018;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="110" y="464" width="760" height="56" as="geometry" /></mxCell>
