    <mxCell id="cap" value="the database resolves every caller from opaque handles — no identity is taken from a header; one access decision for REST, RPC and MCP; each layer fails closed" style="text;html=1;align=center;fontStyle=2;fontSize=12;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="110" y="552" width="760" height="20" as="geometry" /></mxCell>
