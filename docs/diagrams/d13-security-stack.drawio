    <mxCell id="e3" value="x-login-session + x-organization-session" style="html=1;endArrow=classic;strokeColor=#143d2b;fontColor=#5d665d;fontSize=11;exitX=0.5;exitY=1;entryX=0.3;entryY=0" edge="1" parent="1" source="px" target="guc"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e4" value="{connection}" style="html=1;endArrow=classic;strokeColor=#0f766e;fontColor=#5d665d;fontSize=11;exitX=0.5;exitY=1;entryX=0.7;entryY=0" edge="1" parent="1" source="vk" target="guc"><mxGeometry relative="1" as="geometry" /></mxCell>
