<mxGraphModel adaptiveColors="none" background="#fbfaf7" grid="0" page="1" pageWidth="980" pageHeight="560">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="lbl" value="TEST EXECUTION — INSIDE THE DEPLOY TRANSACTION, ZERO RESIDUE" style="text;html=1;align=left;fontStyle=1;fontSize=11;fontColor=#143d2b;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="500" height="20" as="geometry" /></mxCell>
    <mxCell id="mc" value="CALL pgmi_test();&#10;a macro in your deploy.sql" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#b45309;fontColor=#ffffff;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="60" y="66" width="250" height="56" as="geometry" /></mxCell>
    <mxCell id="pp" value="Go preprocessor expands it —&#10;pgmi_test_generate() emits inline SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1e7;strokeColor=#143d2b;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="380" y="66" width="270" height="56" as="geometry" /></mxCell>
    <mxCell id="pl" value="the plan is queryable first:&#10;pgmi_test_plan(pattern) — ordinal ·&#10;step_type · script_path · directory · depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;dashed=1;fontColor=#172018;fontSize=11" vertex="1" parent="1"><mxGeometry x="710" y="60" width="230" height="68" as="geometry" /></mxCell>
    <mxCell id="tx" value="inside the deployment transaction" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#d9f4e8;strokeColor=#0f766e;fontColor=#172018;fontStyle=1;fontSize=12" vertex="1" parent="1"><mxGeometry x="60" y="164" width="880 " height="270" as="geometry" /></mxCell>
    <mxCell id="s1" value="fixture — _setup.sql&#10;once per __test__/ directory,&#10;inside the directory's SAVEPOINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="90" y="210" width="250" height="72" as="geometry" /></mxCell>
    <mxCell id="s2" value="test — each script in its own&#10;SAVEPOINT, rolled back after it runs&#10;(nested directories nest savepoints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="380" y="210" width="270" height="72" as="geometry" /></mxCell>
    <mxCell id="s3" value="teardown — the directory's&#10;SAVEPOINT rolls back:&#10;fixtures leave no residue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="690" y="210" width="230" height="72" as="geometry" /></mxCell>
    <mxCell id="st" value="the three step types are the contract: 'fixture' · 'test' · 'teardown'" style="text;html=1;align=center;fontSize=11;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="830" height="20" as="geometry" /></mxCell>
    <mxCell id="fail" value="a failing test RAISEs — the deployment aborts (exit 13) before anything commits;&#10;on success, your deploy.sql decides whether and when to COMMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;fontColor=#172018;fontSize=12" vertex="1" parent="1"><mxGeometry x="90" y="340" width="830" height="56" as="geometry" /></mxCell>
    <mxCell id="e1" style="html=1;endArrow=classic;strokeColor=#b45309;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="mc" target="pp"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e2" style="html=1;endArrow=classic;strokeColor=#143d2b;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="pp" target="tx"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e3" style="html=1;endArrow=classic;strokeColor=#0f766e;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="e4" style="html=1;endArrow=classic;strokeColor=#0f766e;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="cap" value="test data never persists, migrations commit normally — the gate and the deployment share one transaction" style="text;html=1;align=center;fontStyle=2;fontSize=12;fontColor=#5d665d;" vertex="1" parent="1"><mxGeometry x="90" y="470" width="800" height="20" as="geometry" /></mxCell>
  </root>
