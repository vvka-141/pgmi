+/// The transaction status of a session, as reported by the server.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum TransactionStatus {
+    /// Not in a transaction block.
+    Idle,
+    /// In a transaction block.
+    InTransaction,
+    /// In a failed transaction block. Queries are rejected until the block is ended.
+    InFailedTransaction,
+}
+
 /// An asynchronous PostgreSQL client.
 ///
 /// The client is one half of what is returned when a connection is established. Users interact with the database
 /// through this client object.
 pub struct Client {
     inner: Arc<InnerClient>,
+    transaction_status: Arc<AtomicU8>,
     #[cfg(feature = "runtime")]
     socket_config: Option<SocketConfig>,
     ssl_mode: SslMode,
@@ -191,6 +205,7 @@ pub struct Client {
 impl Client {
     pub(crate) fn new(
         sender: mpsc::UnboundedSender<Request>,
+        transaction_status: Arc<AtomicU8>,
         ssl_mode: SslMode,
         ssl_negotiation: SslNegotiation,
         process_id: i32,
@@ -202,6 +217,7 @@ impl Client {
                 cached_typeinfo: Default::default(),
                 buffer: Default::default(),
             }),
+            transaction_status,
             #[cfg(feature = "runtime")]
             socket_config: None,
             ssl_mode,
@@ -211,6 +227,19 @@ impl Client {
         }
     }
 
+    /// Returns the transaction status the server reported in its most recent `ReadyForQuery` message.
+    ///
+    /// The server sends `ReadyForQuery` at the end of every query cycle, so after a query's future has completed this
+    /// is the status that query left the session in. It is useful after `simple_query` or `batch_execute` runs a
+    /// script that may contain its own `BEGIN`, `COMMIT` or `ROLLBACK`.
+    pub fn transaction_status(&self) -> TransactionStatus {
+        match self.transaction_status.load(Ordering::Acquire) {
+            b'T' => TransactionStatus::InTransaction,
+            b'E' => TransactionStatus::InFailedTransaction,
+            _ => TransactionStatus::Idle,
+        }
+    }
+
     pub(crate) fn inner(&self) -> &Arc<InnerClient> {
         &self.inner
     }
