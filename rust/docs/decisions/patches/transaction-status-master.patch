+#[tokio::test]
+async fn transaction_status() {
+    let client = connect("user=postgres").await;
+    assert_eq!(client.transaction_status(), TransactionStatus::Idle);
+
+    client.batch_execute("BEGIN").await.unwrap();
+    assert_eq!(
+        client.transaction_status(),
+        TransactionStatus::InTransaction
+    );
+
+    client.batch_execute("SELECT 1/0").await.unwrap_err();
+    assert_eq!(
+        client.transaction_status(),
+        TransactionStatus::InFailedTransaction
+    );
+
+    client.batch_execute("ROLLBACK").await.unwrap();
+    assert_eq!(client.transaction_status(), TransactionStatus::Idle);
+
+    client
+        .batch_execute("BEGIN; CREATE TEMPORARY TABLE t (); COMMIT; BEGIN")
+        .await
+        .unwrap();
+    assert_eq!(
+        client.transaction_status(),
+        TransactionStatus::InTransaction
+    );
+}
