# Demo code from pgmi. Do not copy this file into the project as is. It is a
# baseline to learn from, not a library. Read it, then
# write your own gateway that fits this project. Namespaces, modules and
# package names are examples: rename them to match the project.
#
# Every version is pinned exactly and Cargo.lock is committed: a gateway is a
# binary, and its security review covers the versions it was reviewed with.

[package]
name = "pgmi-gateway"  # ADAPT
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
async-trait = "=0.1.92"
axum = "=0.8.9"
base64 = "=0.23.1"
deadpool-postgres = "=0.14.2"
form_urlencoded = "=1.2.2"
hmac = "=0.13.0"
hyper-util = { version = "=0.1.21", features = ["server-auto", "service", "tokio"] }
# ID and access tokens. aws_lc_rs is the crypto backend (exactly one must be
# enabled); rust_crypto is the pure-Rust alternative.
jsonwebtoken = { version = "=11.1.0", default-features = false, features = ["aws_lc_rs"] }
lru = "=0.19.0"
native-tls = "=0.2.18"
postgres-native-tls = "=0.5.3"
rand = "=0.10.3"
# The identity provider: native-tls, the same TLS stack as the database.
reqwest = { version = "=0.13.5", default-features = false, features = ["native-tls", "json"] }
serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.154"
sha2 = "=0.11.1"
tokio = { version = "=1.54.1", features = ["macros", "rt-multi-thread", "net", "signal", "sync", "time"] }
tokio-postgres = { version = "=0.7.18", features = ["with-serde_json-1"] }
tower = { version = "=0.5.3", features = ["util"] }
tracing = "=0.1.44"
tracing-subscriber = "=0.3.23"

[dev-dependencies]
http-body-util = "=0.1.5"
