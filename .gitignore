# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Windows NUL device artifact
nul

# Build output (root-anchored: a bare "pgmi" would also hide crates/pgmi/)
bin/
dist/
/pgmi
/pgmi.exe

# Hugo website build artifacts
website/public/
website/resources/
.hugo_build.lock
.hugo-cache-review/
.hugo-public-review/
.hugo-server/
.tools/
.playwright-mcp/

# Python bytecode artifacts (e.g. from compiling the MCP gateway template)
__pycache__/
*.pyc

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Test scaffolds (pgmi init output during development)
test_*/
.user/

# Scratch space. A Hugo build of the blog was committed here once and shipped
# 14 MB of unrelated generated HTML in every source archive.
.tmp/

# Loose images at the repository root are diagram-review exports, never
# published assets — those live under docs/.
/*.png
/*.jpg
/blackbox/.venv/
/blackbox/.pytest_cache/

# Rust build output
/target/
/THIRD-PARTY-LICENSES
